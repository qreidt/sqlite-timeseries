# Benchmark configuration, read by every script in scripts/.
#
# Override values without editing this file:
#   - put them in config.local.env (same format, not committed), or
#   - set them in the environment:  SCALE=1000 scripts/run-all.sh
#   - or pick a preset:             scripts/run-all.sh small | main | cardinality
# Precedence: environment > preset > config.local.env > config.env.

# --- Dataset (generated by TSBS) -------------------------------------------------------------
USE_CASE=cpu-only                 # cpu-only | devops | iot (the query set needs cpu-only or devops)
SCALE=100                         # number of hosts (trucks for iot)
TS_START=2016-01-01T00:00:00Z
TS_END=2016-01-02T00:00:00Z
LOG_INTERVAL=10s                  # time between readings per host
SEED=123                          # TSBS seed: same seed, same data
WRITE_PARQUET=true                # also write Parquet (zstd), the compression baseline

# --- Queries ---------------------------------------------------------------------------------
QUERIES=100                       # measured queries per query type
QUERY_WARMUP=5                    # extra queries per type, run first and not measured
QUERY_SEED=123
QUERY_TYPES=""                    # space-separated subset, e.g. "lastpoint high-cpu-1"; empty = every type that fits

# --- SQLite engines (files in engines/) ------------------------------------------------------
SQLITE_ENGINES="sqlite sqlite-clustered"   # add "timeseries" once the extension builds
SQLITE_BATCH_SIZE=10000                    # rows per transaction (TSBS's default batch size)
EXTENSION_PATH=""                          # loadable extension, for engines with an `extension` key

# --- TimescaleDB (Docker) --------------------------------------------------------------------
TIMESCALE_IMAGE=timescale/timescaledb:2.31.0-pg17
TSDB_LOAD_WORKERS="1"             # space-separated, e.g. "1 8" loads twice; 1 matches SQLite's single writer
TSDB_BATCH_SIZE=10000
TSDB_CHUNK_INTERVAL=12h           # TSBS's default chunk interval
TSDB_DIRECT_COMPRESS=false        # true: COPY writes straight into the columnstore
TSDB_KEEP_RUNNING=false           # leave the container running after the benchmark
TSDB_PORT=5432                    # host port (127.0.0.1 only)
TS_TUNE_MEMORY=4GB                # what timescaledb-tune sizes PostgreSQL for; applied when the
TS_TUNE_NUM_CPUS=4                # volume is first created (docker compose down -v to re-apply)
POSTGRES_PASSWORD=bench

# --- Paths (relative paths are relative to this folder) --------------------------------------
DATA_ROOT=data                    # datasets: TSBS output, CSV, Parquet, manifest
DB_ROOT=dbs                       # SQLite databases
RESULTS_ROOT=results              # result JSON files and reports
